# Notification Service - Environment Variables

# Environment
ENVIRONMENT=development
DEBUG=True

# MongoDB (for notification logs)
MONGODB_URL=mongodb://admin:secret@mongodb:27017
MONGODB_DB_NAME=notifications

# RabbitMQ
RABBITMQ_URL=amqp://admin:secret@rabbitmq:5672

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
FROM_EMAIL=noreply@flighthub.com
FROM_NAME=FlightHub

# Email Templates
EMAIL_TEMPLATE_DIR=/app/templates

# Notification Settings
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60

# Logging
LOG_LEVEL=INFO
