# Payment Service - Environment Variables

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=*

# Database
DB_HOST=postgres
DB_NAME=payment_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# RabbitMQ
RABBITMQ_URL=amqp://admin:secret@rabbitmq:5672

# Payment Providers
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

KASPI_API_KEY=your_kaspi_api_key
KASPI_MERCHANT_ID=your_kaspi_merchant_id
KASPI_BASE_URL=https://kaspi.kz/api

# Payment Settings
USE_MOCK_PROVIDER=True
MOCK_SUCCESS_RATE=0.9

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
DJANGO_LOG_LEVEL=INFO
