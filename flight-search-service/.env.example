# Application Settings
APP_NAME=Flight Search Service
ENVIRONMENT=development
DEBUG=True

# MongoDB Configuration
MONGODB_URL=mongodb://admin:secret@localhost:27017
MONGODB_DB_NAME=flight_search

# Redis Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Celery Configuration
CELERY_BROKER_URL=amqp://admin:secret@localhost:5672
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# GDS Providers
# Amadeus API (https://developers.amadeus.com/)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com/v2

# Sabre API
SABRE_API_KEY=
SABRE_BASE_URL=https://api.sabre.com/v1

# Mock Provider (for testing)
USE_MOCK_PROVIDER=True

# Search Configuration
MAX_CONCURRENT_SEARCHES=3
SEARCH_TIMEOUT_SECONDS=30
MAX_RESULTS_PER_PROVIDER=50

# Cache Settings
POPULAR_ROUTES_CACHE_HOURS=24
AIRPORT_DATA_CACHE_DAYS=7
